.env
docker/dev/.env
docker/prod/.env

# Segredos de producao em arquivo (senha do banco, JWT, senha do ADMIN).
# O README do diretorio e versionado; o conteudo dos segredos, nunca.
docker/prod/secrets/*
!docker/prod/secrets/README.md

# Prints do painel do provedor e do registro.br usados no deploy (IP, porta SSH)
deploy/

# Configuracao local do Claude Code (skills e permissoes pessoais)
.claude/

# Saida de compilacao da IDE (IntelliJ)
out/

# Resultados de execucao dos testes de carga — gerados pelo coletar-metricas.sh
# e pelo k6; os scripts e o README ficam versionados
testes-carga/resultado-*

# Java / Maven
backend/target/
gateway/target/
**/.mvn/wrapper/maven-wrapper.jar
**/mvnw.cmd
*.class
*.jar
*.war

# Node / Frontend
frontend-web/node_modules/
frontend-web/dist/
frontend-web/.next/
frontend-web/out/
frontend-web/.nuxt/

# IDEs
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/
