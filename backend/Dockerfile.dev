# ============================================================
# Backend — Desenvolvimento
# Hot reload via Spring Boot DevTools + Maven wrapper
# ============================================================
FROM eclipse-temurin:21-jdk

WORKDIR /app

# Copia o wrapper antes do código para aproveitar cache de camada
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./

RUN ./mvnw dependency:go-offline -q

COPY src ./src

EXPOSE 8080

# Spring DevTools detecta alterações no classpath e reinicia automaticamente
CMD ["./mvnw", "spring-boot:run", "-Dspring-boot.run.profiles=dev"]
