# ============================================================
# Gateway — Desenvolvimento
# ============================================================
FROM eclipse-temurin:21-jdk

WORKDIR /app

COPY .mvn/ .mvn/
COPY mvnw pom.xml ./

# O bit de execucao do mvnw nao sobrevive a um clone/checkout feito no
# Windows. Sem isso o RUN abaixo falha com exit 126 (permission denied).
RUN chmod +x mvnw

RUN ./mvnw dependency:go-offline -q

COPY src ./src

EXPOSE 9090

CMD ["./mvnw", "spring-boot:run", "-Dspring-boot.run.profiles=dev"]
