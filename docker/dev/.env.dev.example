# ============================================================
# Variáveis de ambiente — Desenvolvimento
# Copie para .env e ajuste os valores
# NUNCA commite o .env real no git
# ============================================================

# Banco de dados
POSTGRES_DB=prontudigital
POSTGRES_USER=user_admin
POSTGRES_PASSWORD=secret123

# JWT — desenvolvimento (valores fixos para facilitar debug)
#
# O token é assinado com HS512, que pela RFC 7518 §3.2 exige chave de no
# mínimo 512 bits — ou seja, 64 CARACTERES. Com menos, a aplicação sobe
# normalmente e só quebra no login, com "key's size is N bits which is not
# secure enough for the HS512 algorithm".
JWT_ACCESS_EXPIRATION_MS=600000000
JWT_REFRESH_EXPIRATION_MS=600000000
JWT_SECRET=dev-secret-hs512-prontudigital-chave-de-desenvolvimento-com-64-bytes-no-minimo

# Portas expostas no host
# CADDY_PORT   → porta de entrada (mesma que o gateway usava)
# BACKEND_PORT → acesso direto ao Spring, contornando o Caddy.
#                Conveniência de debug; em produção o backend NÃO é
#                publicado no host.
CADDY_PORT=9090
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# ------------------------------------------------------------
# Frontend — duas variáveis DISTINTAS:
#
# NEXT_PUBLIC_API_URL  → usada pelo NAVEGADOR, embutida no build.
#                        Aponta para o Caddy, publicado no host.
# BACKEND_INTERNAL_URL → usada pelo SERVIDOR Next (Route Handlers de
#                        /api/auth/session e /api/auth/refresh), em
#                        runtime. Vai direto ao backend: os dois estão
#                        na mesma rede Docker, então passar pelo Caddy
#                        seria um salto sem função.
#
# Ambas são BASE, sem sufixo de caminho — o código monta /api/auth/...
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:9090
BACKEND_INTERNAL_URL=http://backend:8080

# ------------------------------------------------------------
# WhatsApp Cloud API — número de TESTE da Meta
#
# developers.facebook.com → app "prontudigital" → WhatsApp → Início rápido
#   • PHONE_NUMBER_ID  → "ID do número de telefone" (não é o telefone)
#   • ACCESS_TOKEN     → token temporário, EXPIRA EM 24h
#
# Só envia para os até 5 números cadastrados na lista "Para".
# Deixe VAZIAS para rodar sem WhatsApp: o envio falha, grava FALHA no
# log_notificacoes_whatsapp e o agendamento segue normal.
