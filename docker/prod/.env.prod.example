# ============================================================
# Variáveis de ambiente — PRODUÇÃO
# Copie para docker/prod/.env e preencha. NUNCA commite o .env real.
# ============================================================

# --- Domínio ---
# Sem https:// e sem barra final. Precisa ter um registro A apontando
# para o IP do servidor ANTES de subir — o Caddy valida via HTTP-01.
DOMINIO=prontudigital.com.br

# --- Banco de dados ---
POSTGRES_DB=prontudigital
POSTGRES_USER=user_admin
# Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=TROQUE-ESTA-SENHA

# --- JWT ---
# Gere com: openssl rand -base64 64
#
# HS512 exige chave de 512 bits (RFC 7518 §3.2) — 64 CARACTERES no mínimo.
# Abaixo disso a aplicação sobe e só falha no login, o que torna o problema
# difícil de associar à causa. O placeholder abaixo já tem 78 caracteres,
# mas NÃO deve ir para produção: gere um valor aleatório.
JWT_SECRET=TROQUE-POR-CHAVE-ALEATORIA-COM-NO-MINIMO-64-CARACTERES-veja-o-comentario-acima
JWT_ACCESS_EXPIRATION_MS=900000       # 15 min
JWT_REFRESH_EXPIRATION_MS=604800000   # 7 dias — igual ao maxAge do cookie __pd_rt

# --- Backup (RNF02) — ver scripts/README.md ---
# Comando que envia os backups para FORA deste servidor. Sem ele, as
# cópias ficam no mesmo disco que deveriam proteger.
# Ex.: rclone sync /var/backups/prontudigital remoto:prontudigital
COMANDO_COPIA_EXTERNA=

# Retenção (opcional; padrão 14 diários / 8 semanais)
RETENCAO_DIAS=14
RETENCAO_SEMANAIS=8

# ============================================================
# Não há variável de CORS: o Caddy serve frontend e API no mesmo
# domínio, então as chamadas são same-origin e o navegador não
# dispara preflight. (O CORS existia por causa do gateway, removido.)
#
# Também não há variável de frontend aqui:
#
#  NEXT_PUBLIC_BASE_URL  → derivada de DOMINIO como build arg no
#    compose e embutida no bundle durante o build. Trocar o domínio
#    exige rebuild, não basta reiniciar:
#      docker compose -f docker-compose.prod.yml up -d --build frontend
#
#  BACKEND_INTERNAL_URL  → fixa (http://backend:8080), definida
#    direto no compose: é nome de serviço na rede Docker.
# ============================================================
