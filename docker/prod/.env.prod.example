# ============================================================
# Variáveis de ambiente — Produção
# Copie para .env e preencha com valores reais e seguros
# NUNCA commite este arquivo no git
# ============================================================

# Banco de dados
POSTGRES_DB=prontudigital
POSTGRES_USER=              # defina um usuário forte
POSTGRES_PASSWORD=          # use senha longa e aleatória

# JWT — produção (use gerador de segredos: openssl rand -hex 64)
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_SECRET=                 # OBRIGATÓRIO: mínimo 64 caracteres

# Domínio público (usado pelo Nginx e CORS)
FRONTEND_DOMAIN=https://meusite.com.br

# CORS — origens permitidas pelo gateway
CORS_ALLOWED_ORIGINS=https://meusite.com.br
